# Copy to .env (gitignored) and fill in. Never commit the real file.

# Gemini API key with access to the image models (Nano Banana 2 / Nano Banana Pro).
GEMINI_API_KEY=

# Where raw renders land before curation and staging. Keep it outside any git repo.
ARTIFICER_OUTPUT_DIR=D:\Workbench\LOCAL\artificer-output

# Python interpreter for the token cutout script (Pillow + numpy required, rembg optional)
# ARTIFICER_PYTHON=python

# Max milliseconds to wait for a single API call (default 120000)
# ARTIFICER_TIMEOUT_MS=120000
