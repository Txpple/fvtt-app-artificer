# Copy to .env (gitignored) and fill in. Never commit the real file.
# After any change, restart Claude Code, then run imagegen-status: it checks everything below.

# Gemini API key. Create one at https://aistudio.google.com/apikey. The image models this server
# uses (gemini-nano-banana-2.1, gemini-3-pro-image) have no free tier on the Gemini API (Google's
# pricing page, 2026-10-10), so the key's Google Cloud project needs billing enabled (paid tier).
GEMINI_API_KEY=

# Where raw renders land before curation and staging. The server creates it (parents included)
# on the first render. It must be OUTSIDE any git repo: imagegen-status warns if it is inside one.
# Default: <home>\Documents\imagegen-output
# IMAGEGEN_OUTPUT_DIR=D:\path\to\imagegen-output

# Python 3 interpreter for the token cutout (Pillow + numpy required, rembg optional; install
# with: <python> -m pip install -r requirements.txt). On Windows, bare "python" may be the
# Microsoft Store placeholder, which runs nothing: give the full path to a real python.exe.
# IMAGEGEN_PYTHON=C:\path\to\python.exe

# Max milliseconds to wait for a single API call (default 120000)
# IMAGEGEN_TIMEOUT_MS=120000
