{
  "name": "fvtt-mcp-imagegen",
  "version": "1.3.0",
  "description": "MCP server that makes Foundry VTT art with the Gemini image API, driven by Claude Code.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@foundryvtt/foundryvtt-cli": "^3.0.4",
    "@types/node": "^26.0.0",
    "knip": "^5.64.0",
    "typescript": "^6.0.3",
    "vitest": "~3.2.6"
  },
  "allowScripts": {
    "classic-level": true,
    "esbuild": true
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Txpple",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Txpple/fvtt-mcp-imagegen.git"
  },
  "keywords": [
    "foundry-vtt",
    "mcp",
    "claude-code",
    "gemini",
    "nano-banana",
    "image-generation",
    "tabletop",
    "rpg"
  ]
}
